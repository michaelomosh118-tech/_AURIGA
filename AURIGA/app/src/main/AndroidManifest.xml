<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Essential Permissions for Auriga Ecosystem -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Voice navigation: mic access + foreground service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- AurigaCoreService uses foregroundServiceType="camera|microphone".
         Android 14+ enforces a matching permission for each declared type;
         omitting FOREGROUND_SERVICE_CAMERA causes a hard SecurityException
         when the service is started on API 34+ devices. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    
    <!-- Bluetooth LE camera connectivity (API 31+ split permissions) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- USB Host: connect PIC, STM32, ESP32, Arduino, etc. via OTG cable -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Required for Play Store to ensure the device has a camera -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".AurigaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AurigaHUDTheme"
        android:hardwareAccelerated="true"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true">

        <!--
            Launcher: NATIVE YOLOv8n Object Locator HUD (Phase 1 of
            the strategy doc). CameraX preview + on-device TFLite
            inference + DrakoVoice readout, no WebView, no cloud.
            Falls back to the legacy WebView locator if the bundled
            yolov8n_*.tflite asset is missing.
        -->
        <activity
            android:name=".LocatorActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AurigaHUDTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Legacy web-replica Object Locator HUD. Still registered so
            LocatorActivity's "model not bundled" panel can hand off
            to it as a fallback. No longer the launcher activity.
        -->
        <activity
            android:name=".LocatorWebActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AurigaHUDTheme" />

        <!-- Legacy native HUD (ML Kit + native DrakoVoice). Still available
             for diagnostics and in-house testing; reachable by intent but
             no longer the launcher activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaHUDTheme" />

        <!-- Object Targets picker (Phase 1 of Object Locator on APK).
             Lets the user pick which ML Kit detection categories should
             trigger haptic + DrakoVoice feedback on the live HUD. Runs
             fully offline via the bundled object-detection model. -->
        <activity
            android:name=".TargetsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- DrakoVoice Reader: OrCam-style page reader. Uses on-device
             ML Kit text recognition + TextToSpeech; works fully offline. -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- Hamburger-drawer destinations (0.4e). Both are presentational
             and read from the package metadata; no permissions required. -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- 10-point Calibration Walk + Send Feedback (D3 + D1). The walk
             persists `calibration_walk_completed`; FeedbackActivity refuses
             to load until that flag is set. -->
        <activity
            android:name=".CalibrationWalkActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />
        <activity
            android:name=".FeedbackActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- Hamburger drawer v0.5: Support Centre + Contribute screens. -->
        <activity
            android:name=".SupportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />
        <activity
            android:name=".ContributeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- AI Assistant model download + status screen. -->
        <activity
            android:name=".ModelStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/AurigaDocTheme" />

        <!-- Voice Navigation: first-run name setup + rename from drawer. -->
        <activity
            android:name=".VoiceSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AurigaDocTheme" />

        <!-- Voice Navigation: always-on wake-word foreground service.
             foregroundServiceType="microphone" is required on Android 14+
             for a foreground service that uses the mic. -->
        <service
            android:name=".AurigaVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- AurigaCoreService: master foreground service that owns every engine
             (OutputLayer, CommandRouter, PassiveHazardEngine, StairSenseEngine,
             TrafficSenseEngine, CrossingGuardEngine, EmergencySOSEngine,
             ColorSenseEngine, FaceVaultEngine, PillGuardEngine, CashLensEngine,
             LabelReaderEngine, SpatialMemoryEngine, SceneDescriberEngine,
             GodsEyeOrchestrator, YoloDetector) and runs the CameraX analysis
             loop. foregroundServiceType="camera|microphone" is required on
             Android 14+ for services that access the camera or mic while
             running in the background. Session 17 — Phase 3 integration. -->
        <service
            android:name=".AurigaCoreService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Camera Stream: turns the phone into a wireless MJPEG camera server
             so any laptop running camera-connect.html (Wi-Fi → MJPEG) can
             receive the live feed over the local network. Uses a plain Java
             ServerSocket on port 8080 — no external deps, works on NAVI and
             ARAEL (sentinel) flavors. -->
        <activity
            android:name=".CameraStreamActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AurigaHUDTheme" />

        <!-- Camera Connect: external camera over Wi-Fi / BT LE / USB Serial.
             Supports IP cameras (MJPEG/WS), ESP32-CAM, nRF52 BLE modules,
             PIC18F + USB CDC, STM32, RP2040, Arduino, any CH340/FTDI/CP2102
             USB-to-serial adapter via the Android USB Host API. -->
        <activity
            android:name=".CameraConnectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AurigaDocTheme" />

        <!-- Crash viewer: surfaces the last crash report on launch with
             COPY / SHARE / DISMISS buttons so users can exfiltrate stack
             traces without adb (Android 11+ scoped storage blocks
             /Android/data in Samsung My Files). Built entirely from
             code-constructed Views so it cannot itself fail to inflate
             if a drawable/theme is the very thing that crashed. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- AurigaAlarmReceiver: handles AlarmManager broadcasts for the
             alarm + reminder skill (AurigaSkillEngine). Must be registered
             here to fire when the app is in the background or killed. -->
        <receiver
            android:name=".AurigaAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drakosanctis.auriga.ALARM_FIRE"/>
                <action android:name="com.drakosanctis.auriga.REMINDER_FIRE"/>
            </intent-filter>
        </receiver>

        <!-- FileProvider so Share intents can attach the raw crash file
             (required for emailing / Drive / cloud attachments). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.crashprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/crash_provider_paths" />
        </provider>

    </application>

</manifest>
