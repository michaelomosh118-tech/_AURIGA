<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_space"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp"
        android:gravity="center_horizontal">

        <!-- Brand title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="AURIGA"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/auriga_cyan"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.2"
            android:shadowColor="@color/auriga_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="36dp"
            android:text="Voice Navigation Setup"
            android:textSize="14sp"
            android:textColor="@color/muted_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Name your voice assistant. You will wake it by saying your chosen name followed by AURIGA — for example:"
            android:textSize="15sp"
            android:textColor="@color/hud_text"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center" />

        <!-- Wake phrase preview — updated live as user types -->
        <TextView
            android:id="@+id/voice_wake_example"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="&quot;Nova, AURIGA&quot;"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/auriga_cyan"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:background="@drawable/hud_glass_card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:shadowColor="@color/auriga_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <!-- Field label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="ASSISTANT NAME"
            android:textSize="11sp"
            android:textColor="@color/muted_label"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18" />

        <!-- Name input -->
        <EditText
            android:id="@+id/voice_name_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="6dp"
            android:hint="e.g. Nova, Aria, Echo…"
            android:textSize="18sp"
            android:textColor="@color/hud_text"
            android:hintTextColor="@color/muted_label"
            android:background="@drawable/hud_glass_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:maxLength="24"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif-condensed" />

        <!-- Sub-hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="1–24 characters, letters and spaces only"
            android:textSize="11sp"
            android:textColor="@color/drawer_sub_text"
            android:gravity="end" />

        <!-- Confirm button -->
        <Button
            android:id="@+id/voice_setup_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIRM — ACTIVATE VOICE"
            android:textSize="14sp"
            android:textColor="@color/deep_space"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/auriga_cyan"
            android:stateListAnimator="@null" />

        <!-- Skip link -->
        <Button
            android:id="@+id/voice_setup_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Skip — set up later in drawer"
            android:textSize="13sp"
            android:textColor="@color/drawer_sub_text"
            android:background="@null"
            android:stateListAnimator="@null" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"
            android:background="@color/glass_stroke" />

        <!-- How to activate section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="HOW TO ACTIVATE"
            android:textSize="11sp"
            android:textColor="@color/muted_label"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① Say «[Name], AURIGA» aloud — always-on wake word\n② Long-press the centre of the HUD screen\n③ Tap the mic button at the bottom of the locator\n\nSay a command after activation:\n\"open reader\"  ·  \"open targets\"  ·  \"read this page\"\n\"open menu\"  ·  \"go back\"  ·  \"help commands\""
            android:textSize="14sp"
            android:textColor="@color/hud_text"
            android:lineSpacingMultiplier="1.55" />

    </LinearLayout>
</ScrollView>
